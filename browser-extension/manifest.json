{
  "manifest_version": 3,
  "name": "Orbit Work — Brave",
  "version": "0.1.7",
  "description": "Abre os sites do Work em segundo plano e evita duplicar URLs no perfil conectado.",
  "key": "",
  "permissions": ["tabs", "nativeMessaging", "alarms"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Orbit Work",
    "default_popup": "popup.html"
  }
}
